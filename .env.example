# Sales API (Rust/axum over SAP HANA)
API_BASE=https://your-sales-api-host:port
API_KEY=your-api-key

# Dashboard web server
PORT=8080

# First administrator, used only on the very first start to create data\users.json (user:password).
# After that, manage users on the "Users & permissions" page; this line is ignored.
DASH_USERS=admin:ChangeMe2026
SESSION_HOURS=12

# Calls to the Sales API running at the same time, and per-call timeout
UPSTREAM_CONCURRENCY=4
UPSTREAM_TIMEOUT_SEC=300

# Longest date range one screen may ask for
MAX_RANGE_DAYS=800
# First date of the "All dates" option (earliest documents in this company are Jan 2025)
ALL_FROM=2025-01-01

# Background refresh of the last N days (0 = off)
WARM_DAYS=7
WARM_EVERY_MIN=10

# Branch used for the customer outstanding report (4 = Anura Trading Lanka, 5 = Anura Lubricants)
DEFAULT_BPL_ID=4

CACHE_DIR=cache

# SAP Business One Service Layer (read only) for the SAP analytics pages
SL_BASE=https://your-server:50000
SL_COMPANY=COMPANY_DB
SL_USER=user
SL_PASSWORD=password
SL_CONCURRENCY=4
